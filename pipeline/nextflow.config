process {
    executor = 'awsbatch'
    maxForks = 50
    queueSize = 50

    withName: job_dispatch {
        cpus = 4
        memory = '32 GB'
    }
    withName: apply_curation {
        cpus = 8
        memory = '64 GB'
    }
    withName: quality_control {
        cpus = 8
        memory = '64 GB'
        containerOptions = '--memory-swappiness 20 --shm-size 16g'
    }
    withName: quality_control_collector {
        cpus = 1
        memory = '8 GB'
    }
    withName: nwb_units {
        cpus = 4
        memory = '32 GB'
    }
}

process.resourceLabels = ['allen-batch-pipeline': 'aind-ephys-curation-pipeline']

env {
    PIPELINE_VERSION = "0.0.1"
    PIPELINE_URL = "https://github.com/AllenNeuralDynamics/aind-ephys-curation-pipeline"
}
