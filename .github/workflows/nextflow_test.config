nextflow.enable.strict = false

aws.client.anonymous = true

process {
    executor = 'local'
    cpus = 2
    memory = '8 GB'
    containerOptions = '--memory-swap=-1 --memory-swappiness 20 --shm-size=4g'
}

docker {
    enabled = true
    platform = 'linux/amd64'
    // the test data lives in the checkout: mount it so that relative recording paths resolve in the containers
    runOptions = "--user \$(id -u):\$(id -g) --volume ${env('GITHUB_WORKSPACE')}:${env('GITHUB_WORKSPACE')}"
}
